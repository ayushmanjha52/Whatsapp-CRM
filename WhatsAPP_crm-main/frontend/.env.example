# Dev server proxies /api, /socket.io and /auth/whatsapp to this gateway.
VITE_PROXY_TARGET=http://localhost:4000

# Only if the API is served from a different origin in production (not recommended:
# SameSite=Strict cookies need the same site). Leave empty to use relative URLs.
VITE_API_BASE_URL=

# Set to 1 when tunnelling through ngrok's free tier.
VITE_NGROK=0
