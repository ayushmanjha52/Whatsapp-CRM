{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_SOCKET_URL=https://whatsapp-crm-dwbo.onrender.com npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://whatsapp-crm-dwbo.onrender.com/api/:path*" },
    { "source": "/auth/whatsapp/:path*", "destination": "https://whatsapp-crm-dwbo.onrender.com/auth/whatsapp/:path*" },
    { "source": "/webhooks/:path*", "destination": "https://whatsapp-crm-dwbo.onrender.com/webhooks/:path*" },
    { "source": "/healthz", "destination": "https://whatsapp-crm-dwbo.onrender.com/healthz" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
