# ---------- Supabase (Project Settings → API) ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Service role key: server-side only, bypasses RLS. Never commit or expose it.
SUPABASE_SERVICE_ROLE=
# Public bucket that stores WhatsApp media (created automatically).
MEDIA_BUCKET=media

# ---------- Redis (queues, pub/sub, rate limits) ----------
REDIS_URL=redis://localhost:6379

# ---------- Security ----------
# 32 random bytes as 64 hex chars: `openssl rand -hex 32`. Encrypts WhatsApp access tokens.
# Changing it makes stored tokens unreadable (reconnect WhatsApp afterwards).
DATA_ENCRYPTION_KEY=
# Set to 1 in production (HTTPS) so cookies are Secure.
COOKIE_SECURE=0
# Optional: share cookies across subdomains, e.g. .example.com
COOKIE_DOMAIN=
# Comma-separated origins allowed to call the API cross-origin (empty = reflect request origin).
CORS_ORIGINS=
# Where users land after email links and the WhatsApp OAuth redirect.
FRONTEND_BASE_URL=http://localhost:3000
# Public URL of a single-service deployment (e.g. https://crm.example.com). When set (or on
# Render, where RENDER_EXTERNAL_URL is automatic) it fills in FRONTEND_BASE_URL,
# PUBLIC_WEBHOOK_URL and OAUTH_REDIRECT_URI.
PUBLIC_BASE_URL=
# The gateway serves the built frontend from here (the root Dockerfile sets it).
STATIC_DIR=

# ---------- Migrations (bun run migrate / deploy pre-step) ----------
DATABASE_URL=
# First run only: mark 0001…<value> as already applied (e.g. 0016 for the original schema).
MIGRATE_BASELINE=
# Optional: emails allowed to open the queue dashboard at /admin/queues.
ADMIN_EMAILS=

# ---------- Meta / WhatsApp Cloud API ----------
META_APP_ID=
META_APP_SECRET=
# Signs webhook payloads; defaults to META_APP_SECRET.
WHATSAPP_APP_SECRET=
# Any random string; paste the same value in Meta → WhatsApp → Configuration → Verify token.
WHATSAPP_VERIFY_TOKEN=
# Public HTTPS URL of the webhook, shown in Settings: https://your-domain/webhooks/whatsapp
PUBLIC_WEBHOOK_URL=
GRAPH_API_VERSION=v24.0
# OAuth ("Connect with Facebook"). Must be registered in the Meta app's valid OAuth redirect URIs.
OAUTH_REDIRECT_URI=http://localhost:3000/auth/whatsapp/callback
# Optional: Embedded Signup configuration id.
META_CONFIG_ID=

# ---------- Stripe billing (optional: leave STRIPE_SECRET_KEY empty = no plan limits) ----------
STRIPE_SECRET_KEY=
# Webhook endpoint https://your-domain/webhooks/stripe — events: checkout.session.completed,
# customer.subscription.created/updated/deleted/paused/resumed, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# Recurring monthly prices for the paid plans ($29 Growth, $79 Business).
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=

# ---------- AI reply suggestions (optional; Business plan when billing is on) ----------
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
AI_MODEL=
AI_RATE_LIMIT_PER_MINUTE=20

# ---------- Ports & tuning ----------
GATEWAY_PORT=4000
WEBHOOK_PORT=4001
LOG_LEVEL=info
API_RATE_LIMIT_PER_MINUTE=600
SEND_RATE_LIMIT_PER_MINUTE=120
OUTBOUND_RATE_PER_SECOND=50
WORKER_CONCURRENCY_OUTBOUND=20
WORKER_CONCURRENCY_INBOUND=10
WORKER_CONCURRENCY_MEDIA=5
WORKER_CONCURRENCY_CAMPAIGN=2

# ---------- Development only ----------
# Accept unsigned webhooks (for curl testing). Never enable in production.
ALLOW_DEV_NO_SIGNATURE=0
