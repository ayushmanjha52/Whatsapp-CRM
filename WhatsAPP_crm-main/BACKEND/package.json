{
  "name": "backend",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@bull-board/api": "^6.14.2",
    "@bull-board/fastify": "^6.14.2",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/multipart": "^9",
    "@fastify/rate-limit": "^10.0.0",
    "@supabase/supabase-js": "^2.46.1",
    "bullmq": "^5.7.10",
    "fastify": "^5.6.2",
    "fastify-socket.io": "^5.0.1",
    "ioredis": "^5.4.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.1",
    "zod": "^3.23.8"
  },
  "scripts": {
    "gateway": "bun run services/api-gateway/index.ts",
    "webhook": "bun run services/whatsapp-webhook/index.ts",
    "worker": "bun run services/messaging-worker/index.ts",
    "inbox": "bun run services/inbox-service/index.ts",
    "media": "bun run services/media-uploads/index.ts",
    "campaigns": "bun run services/campaign-worker/index.ts",
    "dev:gateway": "bun run --watch services/api-gateway/index.ts",
    "dev:webhook": "bun run --watch services/whatsapp-webhook/index.ts",
    "dev:worker": "bun run --watch services/messaging-worker/index.ts",
    "dev:inbox": "bun run --watch services/inbox-service/index.ts",
    "dev:media": "bun run --watch services/media-uploads/index.ts",
    "dev:campaigns": "bun run --watch services/campaign-worker/index.ts",
    "dev:all": "bunx npm-run-all --parallel dev:gateway dev:webhook dev:worker dev:inbox dev:media dev:campaigns",
    "start:all": "bunx npm-run-all --parallel gateway webhook worker inbox media campaigns",
    "migrate": "bun run tools/migrate.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "smoke": "bun run tools/smoke.ts",
    "simulate:webhook": "bun run tools/simulate-webhook.ts",
    "tap": "bun run tools/realtime-tap.ts",
    "test:bucket": "bun run test/storage-bucket-check.ts",
    "test:enqueue-media": "bun run test/enqueue-media-job.ts",
    "test:media-list": "bun run test/media-list.ts"
  }
}
